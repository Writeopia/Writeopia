    "If %@ can be used to register, we sent a code to it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls %@ zur Registrierung verwendet werden kann, haben wir einen Code dorthin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ se puede usar para registrarse, le enviamos un código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ peut servir à l’inscription, nous y avons envoyé un code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se %@ può essere usato per registrarsi, abbiamo inviato un codice a questo indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が登録に使用できる場合、そのアドレスにコードを送信しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(으)로 가입할 수 있다면 해당 주소로 코드를 보냈습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als %@ gebruikt kan worden om te registreren, hebben we er een code naartoe gestuurd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se %@ puder ser usado para criar uma conta, enviamos um código para esse email."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если на %@ можно зарегистрироваться, мы отправили туда код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 %@ 可用于注册，我们已向它发送了验证码。"
          }
        }
      }
    },
    "If %@ has an account, we sent a code to it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls %@ ein Konto hat, haben wir einen Code dorthin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ tiene una cuenta, le enviamos un código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ est associé à un compte, nous y avons envoyé un code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se %@ ha un account, abbiamo inviato un codice a questo indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のアカウントがある場合、そのアドレスにコードを送信しました。"
