    "Summaries, action points, FAQs, tags and prompts run on this device, even offline and in the private space." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammenfassungen, Aktionspunkte, FAQs, Tags und Prompts laufen auf diesem Gerät, auch offline und im privaten Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resúmenes, puntos de acción, preguntas frecuentes, etiquetas y prompts se ejecutan en este dispositivo, incluso sin conexión y en el espacio privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumés, points d’action, FAQ, tags et prompts s’exécutent sur cet appareil, même hors ligne et dans l’espace privé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riassunti, punti d'azione, FAQ, tag e prompt girano su questo dispositivo, anche offline e nello spazio privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要約、アクションポイント、FAQ、タグ、プロンプトは、オフラインでもプライベートスペースでも、このデバイス上で実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요약, 실행 항목, FAQ, 태그, 프롬프트가 오프라인과 프라이빗 공간에서도 이 기기에서 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samenvattingen, actiepunten, FAQ's, tags en prompts draaien op dit apparaat, ook offline en in de privéruimte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumos, acionáveis, FAQs, tags e prompts rodam neste dispositivo, mesmo offline e no espaço privado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Краткое содержание, план действий, вопросы и ответы, теги и промпты обрабатываются на этом устройстве, даже офлайн и в личном пространстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要、行动要点、常见问题、标签和提示词都在这台设备上运行，即使离线或在私密空间中也是如此。"
          }
        }
      }
    },
