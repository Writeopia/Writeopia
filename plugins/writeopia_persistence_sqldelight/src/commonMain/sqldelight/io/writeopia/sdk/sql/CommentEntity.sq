CREATE TABLE commentEntity (
  id TEXT NOT NULL,
  conversation_id TEXT NOT NULL,
  document_id TEXT NOT NULL,
  conversation_position INTEGER NOT NULL,
  comment_position INTEGER NOT NULL,
  text TEXT NOT NULL,
  PRIMARY KEY(document_id, id)
);

CREATE INDEX commentEntity_document_id_index ON commentEntity(document_id);

selectByDocumentId:
SELECT *
FROM commentEntity
WHERE document_id = ?
ORDER BY conversation_position, comment_position;

selectByDocumentIds:
SELECT *
FROM commentEntity
WHERE document_id IN ?
ORDER BY document_id, conversation_position, comment_position;

insert:
INSERT INTO commentEntity(
  id,
  conversation_id,
  document_id,
  conversation_position,
  comment_position,
  text
)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(document_id, id) DO
UPDATE SET
  conversation_id = excluded.conversation_id,
  conversation_position = excluded.conversation_position,
  comment_position = excluded.comment_position,
  text = excluded.text;

deleteByDocumentId:
DELETE FROM commentEntity
WHERE document_id = ?;

deleteByDocumentIds:
DELETE FROM commentEntity
WHERE document_id IN ?;
