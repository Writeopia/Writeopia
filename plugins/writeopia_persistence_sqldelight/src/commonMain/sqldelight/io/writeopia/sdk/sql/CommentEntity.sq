CREATE TABLE commentEntity (
  id TEXT PRIMARY KEY,
  conversation_id TEXT NOT NULL,
  document_id TEXT NOT NULL,
  comment_position INTEGER NOT NULL,
  text TEXT NOT NULL
);

selectByDocumentId:
SELECT *
FROM commentEntity
WHERE document_id = ?
ORDER BY conversation_id, comment_position;

insert:
INSERT INTO commentEntity(
  id,
  conversation_id,
  document_id,
  comment_position,
  text
)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT(id) DO
UPDATE SET
  conversation_id = excluded.conversation_id,
  document_id = excluded.document_id,
  comment_position = excluded.comment_position,
  text = excluded.text;

deleteByDocumentId:
DELETE FROM commentEntity
WHERE document_id = ?;

deleteByDocumentIds:
DELETE FROM commentEntity
WHERE document_id IN ?;
