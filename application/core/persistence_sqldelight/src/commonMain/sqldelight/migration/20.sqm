-- Story step positions are whole numbers, 10000 apart (POSITION_GAP in the SDK), kept in an
-- INTEGER column. The steps of each document are renumbered in their order, children (the
-- rows with a parent) among their siblings. SQLite can't change the type of a column, so the
-- table is rebuilt; the search index is rebuilt from it.
CREATE TABLE storyStepEntity_positions (
  id TEXT PRIMARY KEY,
  local_id TEXT NOT NULL,
  type INTEGER NOT NULL,
  parent_id TEXT,
  url TEXT,
  path TEXT,
  text TEXT,
  checked INTEGER NOT NULL,
  position INTEGER NOT NULL,
  document_id TEXT NOT NULL,
  is_group INTEGER NOT NULL,
  has_inner_steps INTEGER NOT NULL,
  background_color INTEGER,
  tags TEXT NOT NULL,
  spans TEXT NOT NULL,
  link_to_document TEXT,
  last_updated_at INTEGER
);

INSERT INTO storyStepEntity_positions (
  id, local_id, type, parent_id, url, path, text, checked, position, document_id,
  is_group, has_inner_steps, background_color, tags, spans, link_to_document, last_updated_at
)
SELECT
  s.id, s.local_id, s.type, s.parent_id, s.url, s.path, s.text, s.checked,
  (
    SELECT COUNT(*)
    FROM storyStepEntity o
    WHERE o.document_id = s.document_id
      AND IFNULL(o.parent_id, '') = IFNULL(s.parent_id, '')
      AND (o.position < s.position OR (o.position = s.position AND o.id < s.id))
  ) * 10000,
  s.document_id, s.is_group, s.has_inner_steps, s.background_color, s.tags, s.spans,
  s.link_to_document, s.last_updated_at
FROM storyStepEntity s;

DROP TABLE storyStepEntity;
ALTER TABLE storyStepEntity_positions RENAME TO storyStepEntity;

DROP TABLE storyStepEntityFts;
CREATE VIRTUAL TABLE storyStepEntityFts USING fts4(
  text TEXT,
  id TEXT,
  document_id TEXT UNINDEXED,
  position INTEGER UNINDEXED
);
INSERT INTO storyStepEntityFts (text, id, document_id, position)
SELECT text, id, document_id, position FROM storyStepEntity WHERE text IS NOT NULL;
