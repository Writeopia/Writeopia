CREATE TABLE workspace_entity (
  id TEXT PRIMARY KEY,
  user_id TEXT NOT NULL,
  name TEXT NOT NULL,
  last_synced_at INTEGER NOT NULL,
  last_event_sync_at INTEGER NOT NULL DEFAULT 0,
  icon TEXT,
  icon_tint INTEGER,
  selected INTEGER NOT NULL
);

getWorkspaceById:
SELECT *
FROM workspace_entity
WHERE id = ?
LIMIT 1;

selectCurrentWorkspace:
SELECT *
FROM workspace_entity
WHERE selected = 1
LIMIT 1;

insert:
INSERT INTO workspace_entity(id, user_id, name, last_synced_at, last_event_sync_at, icon, icon_tint, selected)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO
UPDATE SET id=excluded.id, user_id=excluded.user_id, name=excluded.name, last_synced_at=excluded.last_synced_at,
last_event_sync_at=excluded.last_event_sync_at, icon=excluded.icon, icon_tint=excluded.icon_tint, selected=excluded.selected;

unselectAll:
UPDATE workspace_entity
SET selected = 0;

updateLastEventSync:
UPDATE workspace_entity
SET last_event_sync_at = ?
WHERE id = ?;

selectWorkspacesByUser:
SELECT *
FROM workspace_entity
WHERE user_id = ?
ORDER BY name COLLATE NOCASE;

-- Keeps the sync state and the selection of a workspace already known: only its name is refreshed.
upsertWorkspaceName:
INSERT INTO workspace_entity(id, user_id, name, last_synced_at, last_event_sync_at, icon, icon_tint, selected)
VALUES (?, ?, ?, 0, 0, NULL, NULL, 0)
ON CONFLICT(id) DO
UPDATE SET name=excluded.name;

deleteUnselectedOfUserNotIn:
DELETE FROM workspace_entity
WHERE user_id = ?
AND selected = 0
AND id NOT IN ?;
