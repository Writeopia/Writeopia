CREATE TABLE documentTagEntity (
  id TEXT PRIMARY KEY,
  workspace_id TEXT NOT NULL,
  name TEXT NOT NULL,
  description TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  last_updated_at INTEGER NOT NULL,
  last_synced_at INTEGER,
  deleted INTEGER NOT NULL DEFAULT 0
);

selectById:
SELECT *
FROM documentTagEntity
WHERE id = ?;

selectByWorkspace:
SELECT *
FROM documentTagEntity
WHERE workspace_id = ? AND deleted = 0
ORDER BY name;

selectAllByWorkspace:
SELECT *
FROM documentTagEntity
WHERE workspace_id = ?
ORDER BY name;

insert:
INSERT INTO documentTagEntity(id, workspace_id, name, description, created_at, last_updated_at, last_synced_at, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO
UPDATE SET workspace_id=excluded.workspace_id, name=excluded.name, description=excluded.description,
created_at=excluded.created_at, last_updated_at=excluded.last_updated_at,
last_synced_at=excluded.last_synced_at, deleted=excluded.deleted;

softDelete:
UPDATE documentTagEntity
SET deleted = 1, last_updated_at = ?
WHERE id = ? AND workspace_id = ?;

moveToWorkspace:
UPDATE documentTagEntity
SET workspace_id = ?
WHERE workspace_id = ?;
