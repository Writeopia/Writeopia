<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules file for Android 12+ (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted token storage from cloud backups for security -->
        <exclude domain="sharedpref" path="writeopia_secure_tokens.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted token storage from device transfers for security -->
        <exclude domain="sharedpref" path="writeopia_secure_tokens.xml"/>
    </device-transfer>
</data-extraction-rules>
