<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules file for Android Auto Backup (API < 31).
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices API 31+
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude encrypted token storage from backups for security -->
    <exclude domain="sharedpref" path="writeopia_secure_tokens.xml"/>
</full-backup-content>
