CREATE TABLE comment_entity (
  id TEXT PRIMARY KEY,
  conversation_id TEXT NOT NULL,
  document_id TEXT NOT NULL,
  conversation_position BIGINT NOT NULL,
  comment_position BIGINT NOT NULL,
  text TEXT NOT NULL
);

CREATE INDEX comment_entity_document_id_index ON comment_entity(document_id);

selectByDocumentId:
SELECT *
FROM comment_entity
WHERE document_id = ?
ORDER BY conversation_position, comment_position;

insert:
INSERT INTO comment_entity(
  id,
  conversation_id,
  document_id,
  conversation_position,
  comment_position,
  text
)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO
UPDATE SET
  conversation_id = excluded.conversation_id,
  document_id = excluded.document_id,
  conversation_position = excluded.conversation_position,
  comment_position = excluded.comment_position,
  text = excluded.text;

deleteByDocumentId:
DELETE FROM comment_entity
WHERE document_id = ?;

deleteByDocumentIds:
DELETE FROM comment_entity
WHERE document_id IN ?;
