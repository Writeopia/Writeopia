CREATE TABLE comment_entity (
  id TEXT PRIMARY KEY,
  conversation_id TEXT NOT NULL,
  document_id TEXT NOT NULL,
  comment_position BIGINT NOT NULL,
  text TEXT NOT NULL
);

CREATE INDEX comment_entity_document_id_index ON comment_entity(document_id);

selectDocumentIdById:
SELECT document_id
FROM comment_entity
WHERE id = ?;

selectByDocumentId:
SELECT *
FROM comment_entity
WHERE document_id = ?;

insert:
INSERT INTO comment_entity(
  id,
  conversation_id,
  document_id,
  comment_position,
  text
)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT(id) DO
UPDATE SET
  conversation_id = CASE
    WHEN comment_entity.document_id = excluded.document_id THEN excluded.conversation_id
    ELSE comment_entity.conversation_id
  END,
  document_id = comment_entity.document_id,
  comment_position = CASE
    WHEN comment_entity.document_id = excluded.document_id THEN excluded.comment_position
    ELSE comment_entity.comment_position
  END,
  text = CASE
    WHEN comment_entity.document_id = excluded.document_id THEN excluded.text
    ELSE comment_entity.text
  END;

deleteByDocumentId:
DELETE FROM comment_entity
WHERE document_id = ?;

deleteByDocumentIds:
DELETE FROM comment_entity
WHERE document_id IN ?;
