CREATE TABLE user_favorite_entity (
  user_id TEXT NOT NULL,
  document_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (user_id, document_id)
);

selectByUserAndWorkspace:
SELECT document_id
FROM user_favorite_entity
WHERE user_id = ? AND workspace_id = ?;

selectByUserAndDocument:
SELECT *
FROM user_favorite_entity
WHERE user_id = ? AND document_id = ?;

isFavorite:
SELECT COUNT(*) > 0
FROM user_favorite_entity
WHERE user_id = ? AND document_id = ?;

insert:
INSERT INTO user_favorite_entity(user_id, document_id, workspace_id, created_at)
VALUES (?, ?, ?, ?)
ON CONFLICT (user_id, document_id) DO NOTHING;

delete:
DELETE FROM user_favorite_entity
WHERE user_id = ? AND document_id = ?;

deleteByDocument:
DELETE FROM user_favorite_entity
WHERE document_id = ?;

deleteByUser:
DELETE FROM user_favorite_entity
WHERE user_id = ?;

-- All users' favorites in the workspace. Used when the whole workspace is torn down
-- (account-deletion saga) — other members' favorites pointing into it go dangling too,
-- not just the departing user's.
deleteByWorkspace:
DELETE FROM user_favorite_entity
WHERE workspace_id = ?;

-- Just this user's favorites in this one workspace. Used when the user is leaving a
-- workspace that is NOT being deleted (they weren't the sole admin).
deleteByUserAndWorkspace:
DELETE FROM user_favorite_entity
WHERE user_id = ? AND workspace_id = ?;
