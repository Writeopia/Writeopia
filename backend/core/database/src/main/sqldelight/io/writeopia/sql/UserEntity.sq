CREATE TABLE user_entity (
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  username TEXT NOT NULL UNIQUE,
  created_at BIGINT NOT NULL,
  email TEXT NOT NULL UNIQUE,
  password TEXT NOT NULL,
  salt TEXT NOT NULL,
  enabled BOOLEAN NOT NULL,
  confirmation_code TEXT,
  confirmation_code_expiry BIGINT,
  account_type TEXT NOT NULL DEFAULT 'FREE'
);

selectUserByEmail:
SELECT *
FROM user_entity
WHERE email = ?
LIMIT 1;

selectUserByUsernameOrEmail:
SELECT *
FROM user_entity
WHERE username = ? OR email = ?
LIMIT 1;

userExistsByUsernameOrEmail:
SELECT EXISTS(
  SELECT 1
  FROM user_entity
  WHERE username = ? OR email = ?
);

selectEnabledUserByEmail:
SELECT *
FROM user_entity
WHERE email = ? AND enabled = TRUE
LIMIT 1;

selectUserById:
SELECT *
FROM user_entity
WHERE id = ?
LIMIT 1;

insertUser:
INSERT INTO user_entity(id, name, username, created_at, email, password, salt, enabled, confirmation_code, confirmation_code_expiry, account_type)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO
UPDATE SET id=excluded.id, name=excluded.name, username=excluded.username, created_at=excluded.created_at, email=excluded.email, password=excluded.password, salt=excluded.salt, enabled=excluded.enabled, confirmation_code=excluded.confirmation_code, confirmation_code_expiry=excluded.confirmation_code_expiry, account_type=excluded.account_type;

deleteUser:
DELETE
FROM user_entity
WHERE id = ?;

deleteUserByEmail:
DELETE
FROM user_entity
WHERE email = ?;

enableUserByEmail:
UPDATE user_entity
SET enabled = TRUE
WHERE email = ?;

disableUserByEmail:
UPDATE user_entity
SET enabled = FALSE
WHERE email = ?;

updateConfirmationCode:
UPDATE user_entity
SET confirmation_code = ?, confirmation_code_expiry = ?
WHERE email = ?;

clearConfirmationCode:
UPDATE user_entity
SET confirmation_code = NULL, confirmation_code_expiry = NULL
WHERE email = ?;

selectConfirmationCodeByEmail:
SELECT confirmation_code, confirmation_code_expiry
FROM user_entity
WHERE email = ?
LIMIT 1;

searchUsersByEmail:
SELECT id, name, email
FROM user_entity
WHERE email ILIKE '%' || ? || '%' AND enabled = TRUE
ORDER BY email ASC
LIMIT ?
OFFSET ?;

selectAccountTypeById:
SELECT account_type
FROM user_entity
WHERE id = ?
LIMIT 1;

updateAccountType:
UPDATE user_entity
SET account_type = ?
WHERE id = ?;

updatePassword:
UPDATE user_entity
SET password = ?, salt = ?
WHERE id = ?;

