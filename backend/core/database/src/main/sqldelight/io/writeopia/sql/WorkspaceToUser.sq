CREATE TABLE workspace_to_user (
    workspace_id TEXT NOT NULL,
    user_id TEXT NOT NULL,
    role TEXT NOT NULL,
    PRIMARY KEY(workspace_id, user_id)
);

CREATE INDEX idx_workspace_to_user_user_id ON workspace_to_user(user_id);

getUsersInWorkspace:
SELECT
  user_entity.id AS user_entity_id,
  user_entity.name AS user_name,
  user_entity.created_at AS user_created_at,
  user_entity.email AS user_email,
  role
FROM workspace_entity
JOIN workspace_to_user
  ON workspace_entity.id = workspace_to_user.workspace_id
JOIN user_entity
  ON user_entity.id = workspace_to_user.user_id
WHERE workspace_to_user.workspace_id = ?;

getUsersInWorkspacePaginated:
SELECT
  user_entity.id AS user_entity_id,
  user_entity.name AS user_name,
  user_entity.created_at AS user_created_at,
  user_entity.email AS user_email,
  role
FROM workspace_entity
JOIN workspace_to_user
  ON workspace_entity.id = workspace_to_user.workspace_id
JOIN user_entity
  ON user_entity.id = workspace_to_user.user_id
WHERE workspace_to_user.workspace_id = ?
ORDER BY user_entity.name ASC
LIMIT ? OFFSET ?;

countUsersInWorkspace:
SELECT COUNT(*)
FROM workspace_to_user
WHERE workspace_id = ?;

getUserInWorkspace:
SELECT
  user_entity.id AS user_entity_id,
  user_entity.name AS user_name,
  user_entity.created_at AS user_created_at,
  user_entity.email AS user_email,
  role
FROM workspace_entity
JOIN workspace_to_user
  ON workspace_entity.id = workspace_to_user.workspace_id
JOIN user_entity
  ON user_entity.id = workspace_to_user.user_id
WHERE workspace_to_user.workspace_id = ? AND user_entity.email = ?
LIMIT 1;

insertWorkspaceToUser:
INSERT INTO workspace_to_user(workspace_id, user_id, role)
VALUES (?, ?, ?)
ON CONFLICT(workspace_id, user_id) DO UPDATE SET role = excluded.role;

removeUserFromWorkspace:
DELETE FROM workspace_to_user
WHERE workspace_id = ? AND user_id = ?;

-- Bulk delete, all members of the workspace. Used when the whole workspace is torn down
-- (account-deletion saga), as opposed to removeUserFromWorkspace which removes one member.
deleteByWorkspaceId:
DELETE FROM workspace_to_user
WHERE workspace_id = ?;

changeRole:
UPDATE workspace_to_user
SET role = ?
WHERE workspace_id = ? AND user_id = ?;

countAdminsInWorkspace:
SELECT COUNT(*)
FROM workspace_to_user
WHERE workspace_id = ? AND role = 'ADMIN';

getUserRoleInWorkspace:
SELECT role
FROM workspace_to_user
WHERE workspace_id = ? AND user_id = ?;

