CREATE TABLE workspace_tutorial_status (
    workspace_id TEXT NOT NULL,
    user_id TEXT NOT NULL,
    tutorials_created INTEGER NOT NULL DEFAULT 0,
    created_at BIGINT NOT NULL,
    PRIMARY KEY(workspace_id, user_id)
);

getTutorialStatus:
SELECT tutorials_created FROM workspace_tutorial_status
WHERE workspace_id = ? AND user_id = ? LIMIT 1;

setTutorialStatus:
INSERT INTO workspace_tutorial_status(workspace_id, user_id, tutorials_created, created_at)
VALUES (?, ?, ?, ?)
ON CONFLICT(workspace_id, user_id) DO UPDATE SET tutorials_created = excluded.tutorials_created;
